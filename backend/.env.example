# Consilium Boardroom Environment Config

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# 'anthropic' | 'openai' | 'google' | 'groq' | 'ollama'
#
# Leave unset and Consilium picks the first provider that has a working
# credential. Defaulting to one whose key is missing produces a boardroom where
# every seat returns the degraded notice: configured-looking, entirely useless.
#
# All of this is also settable at runtime from the console's Settings panel.
# Keys typed there live in the server process only; put them here to persist.
LLM_PROVIDER=

# Set the key for whichever provider(s) you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Pin a model for every seat. Leave unset and the chair and executives get the
# provider's frontier model while specialists get its balanced one.
# The variable is named <PROVIDER>_MODEL.
#   ANTHROPIC_MODEL=claude-opus-5
#   OPENAI_MODEL=gpt-4.1
#   GOOGLE_MODEL=gemini-2.5-pro
#   GROQ_MODEL=llama-3.3-70b-versatile
#   OLLAMA_MODEL=llama3

# Ollama runs locally and needs no key.
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8000
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Observability - Langfuse LLM tracing (prompts, completions, cost, usage)
# ---------------------------------------------------------------------------
# Unset = tracing off; the app runs identically without it. Both keys must be
# set to enable. Get keys from your Langfuse project settings.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# REQUIRED alongside the keys above, and must be self-hosted (your own VPC) --
# boardroom sessions carry clinical/payer/account detail. Langfuse's own SaaS
# host is refused unless you explicitly set it here, and even then it is not
# a BAA-covered path. `docker compose up` in a cloned langfuse/langfuse repo
# gets you a local host in a few minutes.
# LANGFUSE_HOST=http://localhost:3000
#
# Fraction of generations traced. 1.0 in dev; lower in high-volume prod (cost
# and eval traces stay meaningful well below 1.0 -- errors are never dropped,
# they are a client-side masking decision, not sampling).
# LANGFUSE_SAMPLE_RATE=1.0

# ---------------------------------------------------------------------------
# Persona packs
# ---------------------------------------------------------------------------
# The DEFAULT pack selection for sessions that do not declare their own.
# Unset = "core" only, the domain-neutral boardroom.
#   core,healthcare    -> Consilium Health   (clinical ladder, healthcare guardrails)
#   core,pharma        -> Consilium Pharma   (drug-development ladder)
#   core,lifesciences  -> Life Sciences      (research ladder)
# The LAST pack listed owns the phase ladder and the guardrail policy.
CONSILIUM_PACKS=core,healthcare
