    },
    "groq": {
      "label": "Groq",
      "langchain_provider": "groq",
      "env_key": "GROQ_API_KEY",
      "requires_key": true,
      "docs": "https://console.groq.com/keys",
      "default_model": "llama-3.3-70b-versatile",
